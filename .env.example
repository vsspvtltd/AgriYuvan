# Firebase configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Google Gemini API key
VITE_GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs API key
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key

# OpenWeatherMap API key for weather service
VITE_OPENWEATHER_API_KEY=your-openweathermap-api-key

# Additional configuration
# Weather cache expiration in minutes (default: 60)
VITE_WEATHER_CACHE_EXPIRATION=60

# Default location for weather when user location not available
VITE_DEFAULT_CITY=Mumbai
VITE_DEFAULT_STATE=Maharashtra
